{
  "name": "trazo",
  "private": true,
  "version": "1.0.0",
  "description": "A bilingual, scroll-driven journey through the history of drawing, with pencil illustrations and a 3D paper intro.",
  "author": "OscarTired",
  "license": "MIT",
  "homepage": "https://oscartired.github.io/Trazo/",
  "repository": {
    "type": "git",
    "url": "https://github.com/OscarTired/Trazo.git"
  },
  "packageManager": "pnpm@11.1.2",
  "engines": { "node": ">=24" },
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
